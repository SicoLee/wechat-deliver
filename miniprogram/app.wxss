page { background: #f7f7f7; color: #202124; font-size: 30rpx; }
.page { padding: 24rpx; padding-bottom: 150rpx; }
.card { background:#fff; border-radius:20rpx; padding:24rpx; margin-bottom:20rpx; box-shadow:0 4rpx 16rpx rgba(0,0,0,.04); }
.btn { background:#1aad19; color:#fff; border-radius:12rpx; font-size:30rpx; padding:18rpx 24rpx; text-align:center; }
.btn.secondary { background:#fff; color:#1aad19; border:1rpx solid #1aad19; }
.muted { color:#8a8f98; font-size:26rpx; }
.row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.title { font-size:38rpx; font-weight:700; }
.price { color:#e64340; font-weight:700; }
.fixed-bottom { position:fixed; left:0; right:0; bottom:0; padding:20rpx 24rpx; background:#fff; display:flex; gap:20rpx; align-items:center; box-shadow:0 -2rpx 12rpx rgba(0,0,0,.08); }
