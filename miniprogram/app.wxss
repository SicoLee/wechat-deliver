page { background:#f5f5f7; color:#1d1d1f; font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif; font-size:30rpx; letter-spacing:.1rpx; }
.page { min-height:100vh; box-sizing:border-box; padding:32rpx 28rpx 172rpx; }
.card { box-sizing:border-box; background:#fff; border-radius:28rpx; padding:28rpx; margin-bottom:20rpx; box-shadow:0 8rpx 30rpx rgba(0,0,0,.035); }
.row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.title { color:#1d1d1f; font-size:44rpx; font-weight:700; letter-spacing:-1rpx; line-height:1.16; }
.section-title { font-size:32rpx; font-weight:700; letter-spacing:-.3rpx; margin:40rpx 0 18rpx; }
.muted { color:#86868b; font-size:26rpx; line-height:1.5; }
.price { color:#ff453a; font-weight:700; font-variant-numeric:tabular-nums; }
.btn { box-sizing:border-box; display:inline-flex; min-height:72rpx; padding:0 26rpx; align-items:center; justify-content:center; background:#0071e3; color:#fff; border-radius:999rpx; font-size:27rpx; font-weight:600; line-height:1; text-align:center; }
.btn:active { opacity:.72; transform:scale(.985); }
.btn.secondary { background:#eef5ff; color:#0071e3; border:0; }
.btn.ghost { background:#f5f5f7; color:#1d1d1f; border:0; }
.fixed-bottom { position:fixed; z-index:10; left:0; right:0; bottom:0; box-sizing:border-box; min-height:132rpx; padding:20rpx 28rpx env(safe-area-inset-bottom); background:rgba(255,255,255,.94); backdrop-filter:blur(24rpx); display:flex; gap:16rpx; align-items:center; box-shadow:0 -1rpx 0 rgba(0,0,0,.08); }
.fixed-bottom .btn { min-width:168rpx; }
.hero { padding:26rpx 0 20rpx; }
.hero-meta { margin-top:12rpx; }
.nav-link { color:#0071e3; font-size:27rpx; font-weight:600; }
.menu-item { padding:30rpx 28rpx; }
.menu-name { font-size:33rpx; font-weight:650; letter-spacing:-.3rpx; }
.menu-price { margin-top:10rpx; font-size:28rpx; }
.total-label { flex:1; font-size:27rpx; font-weight:600; }
.input-line { border-bottom:1rpx solid #e5e5ea; padding:22rpx 0; }
.quantity-control { display:flex; align-items:center; gap:16rpx; padding:8rpx; background:#f5f5f7; border-radius:999rpx; }
.quantity-button { width:56rpx; min-width:56rpx; min-height:56rpx; padding:0; background:#fff; color:#0071e3; box-shadow:0 2rpx 8rpx rgba(0,0,0,.06); }
.quantity-value { min-width:42rpx; color:#1d1d1f; font-size:27rpx; font-weight:650; text-align:center; font-variant-numeric:tabular-nums; }
.empty-state { padding:80rpx 32rpx; text-align:center; }
.empty-title { font-size:34rpx; font-weight:700; letter-spacing:-.4rpx; margin-bottom:12rpx; }
.address-actions { display:flex; gap:14rpx; margin-top:24rpx; }
.address-actions .btn { flex:1; padding:0 16rpx; }
.address-selected { margin-top:24rpx; padding:18rpx 20rpx; background:#f5f9ff; border-radius:16rpx; color:#0071e3; font-size:25rpx; line-height:1.45; }
.form-label { display:block; margin:26rpx 0 4rpx; color:#86868b; font-size:24rpx; }
.quote-card { padding:24rpx 28rpx; }
.note-card textarea { width:100%; min-height:72rpx; font-size:29rpx; line-height:1.5; }
.success-mark { width:104rpx; height:104rpx; margin:0 auto 28rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#e9f9ee; color:#34c759; font-size:56rpx; font-weight:700; }
.success-card { padding:72rpx 32rpx; text-align:center; }
.order-number { margin:24rpx 0 12rpx; color:#86868b; font-size:25rpx; font-variant-numeric:tabular-nums; }
.stack-actions { display:flex; flex-direction:column; gap:16rpx; margin-top:28rpx; }
.stack-actions .btn { width:100%; }
.status-badge { display:inline-flex; align-items:center; padding:8rpx 14rpx; border-radius:999rpx; background:#eef5ff; color:#0071e3; font-size:24rpx; font-weight:600; }
.order-card { padding:26rpx 28rpx; }
.order-items { margin-top:16rpx; }
.order-line { margin-top:6rpx; }
.admin-tools { display:flex; gap:14rpx; margin-top:22rpx; }
.admin-tools .btn { flex:1; }
.filter-bar { display:flex; gap:12rpx; overflow-x:auto; margin:16rpx -4rpx -4rpx; padding:4rpx; white-space:nowrap; }
.filter-chip { flex:none; min-height:58rpx; padding:0 20rpx; background:#f5f5f7; color:#6e6e73; font-size:24rpx; }
.filter-chip.active { background:#0071e3; color:#fff; }
.merchant-order { padding:26rpx 28rpx; }
.merchant-order:active, .order-card:active { opacity:.72; }
.merchant-address { margin-top:16rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.merchant-meta { margin-top:18rpx; }
.form-card .section-title { margin-top:0; }
.form-card .btn { width:100%; margin-top:26rpx; }
.product-card { padding:26rpx 28rpx; }
.product-actions { display:flex; gap:12rpx; }
.product-actions .btn { min-width:0; padding:0 18rpx; }
.editing-actions { display:flex; gap:14rpx; margin-top:24rpx; }
.editing-actions .btn { flex:1; }
.detail-list { margin-top:22rpx; }
.detail-row { padding:14rpx 0; }
.detail-divider { height:1rpx; background:#e5e5ea; margin:12rpx 0; }
.detail-summary { padding:26rpx 28rpx; }
.delivery-card { line-height:1.55; }
.detail-actions { display:flex; flex-direction:column; gap:16rpx; margin-top:24rpx; }
.detail-actions .btn { width:100%; }
