<view class="page"><view wx:if="{{!cart.length}}" class="card muted">购物车还是空的，先去选菜吧。</view>
<view wx:for="{{cart}}" wx:key="id" class="card"><view class="row"><view><view>{{item.name}}</view><view class="price">¥{{item.price}}</view></view><view class="row"><view class="btn secondary" data-id="{{item.id}}" bindtap="minus">−</view><view>× {{item.quantity}}</view><view class="btn" data-id="{{item.id}}" bindtap="plus">+</view></view></view></view>
<view wx:if="{{cart.length}}" class="fixed-bottom"><view>商品 <text class="price">¥{{total}}</text></view><view class="btn" bindtap="checkout">填写地址</view></view></view>
