<view class="page" wx:if="{{order}}"><view class="card"><view class="title">#{{order.order_no}}</view><view wx:for="{{order.items}}" wx:key="product_id" class="row"><view>{{item.product_name}} × {{item.quantity}}</view><view>¥{{item.unit_price}}</view></view><view class="row"><view>配送费</view><view>¥{{order.delivery_fee}}</view></view><view class="row"><view>合计</view><view class="price">¥{{order.total_amount}}</view></view></view><view class="card"><view>{{order.address}}</view><view>电话：{{order.phone}}</view><view>模拟骑行距离：{{order.delivery_distance_km}} km</view><view wx:if="{{order.remark}}">备注：{{order.remark}}</view><view>订单：{{order.status}}　打印：{{order.print_status}}</view></view><view class="btn secondary" bindtap="reprint">重新打印</view><view wx:if="{{nextStatus}}" class="btn" style="margin-top:20rpx" bindtap="next">{{nextLabel}}</view></view>
