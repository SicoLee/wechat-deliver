<view class="page"><view wx:if="{{loadError}}" class="card empty-state"><view class="empty-title">暂时无法获取订单</view><view class="muted">{{loadError}}</view></view><view wx:if="{{order}}"><view class="hero"><view class="order-number" style="margin:0">#{{order.order_no}}</view><view class="title" style="margin-top:10rpx">¥{{order.total_amount}}</view><view class="status-badge" style="margin-top:16rpx">{{order.statusLabel}}</view></view><view class="card detail-summary"><view class="section-title" style="margin-top:0">本单菜品</view><view class="detail-list"><view wx:for="{{order.items}}" wx:key="product_id" class="row detail-row"><view>{{item.product_name}} × {{item.quantity}}</view><view>¥{{item.unit_price}}</view></view></view><view class="detail-divider"></view><view class="row detail-row"><view class="muted">配送费</view><view>¥{{order.delivery_fee}}</view></view><view class="row detail-row"><view>合计</view><view class="price">¥{{order.total_amount}}</view></view></view><view class="card delivery-card"><view class="section-title" style="margin-top:0">配送信息</view><view>{{order.address}}</view><view class="muted" style="margin-top:12rpx">联系电话 {{order.phone}} · 骑行 {{order.delivery_distance_km}} km</view><view wx:if="{{order.remark}}" style="margin-top:18rpx">备注：{{order.remark}}</view><view class="muted" style="margin-top:18rpx">打印 {{order.print_status}}</view></view><view class="detail-actions"><view wx:if="{{nextStatus}}" class="btn" bindtap="next">{{nextLabel}}</view><view class="btn ghost" bindtap="reprint">重新打印</view></view></view></view>
