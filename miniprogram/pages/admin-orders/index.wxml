<view class="page"><view class="card"><view class="row"><view class="title">商家后台</view><view class="muted">{{lastUpdated}}</view></view><view class="muted">首次使用请绑定白名单手机号</view><input placeholder="管理员手机号" value="{{phone}}" bindinput="inputPhone" style="padding:18rpx 0"/><view class="btn secondary" bindtap="bind">绑定商家权限</view><view class="btn secondary" style="margin-top:16rpx" bindtap="products">商品管理</view></view>
<view class="card"><view class="muted">订单筛选</view><view class="row" style="flex-wrap:wrap;gap:12rpx;margin-top:16rpx"><view class="btn secondary" data-status="ALL" bindtap="setFilter">全部</view><view class="btn secondary" data-status="PAID" bindtap="setFilter">待制作</view><view class="btn secondary" data-status="MAKING" bindtap="setFilter">制作中</view><view class="btn secondary" data-status="READY_FOR_DELIVERY" bindtap="setFilter">待配送</view><view class="btn secondary" data-status="COMPLETED" bindtap="setFilter">已完成</view></view></view>
<view wx:for="{{filteredOrders}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="row"><view>#{{item.order_no}}</view><view class="price">¥{{item.total_amount}}</view></view><view class="muted">{{item.address}}</view><view>{{item.statusLabel}} · {{item.printLabel}}</view></view><view wx:if="{{loaded&&!filteredOrders.length}}" class="muted">当前筛选下暂无订单</view></view>
