<view class="page"><view class="hero"><view class="row"><view class="title">店铺订单</view><view class="muted">{{lastUpdated}}</view></view><view class="muted hero-meta">查看新订单并安排制作配送。</view></view>
<view class="card"><view class="muted">开发环境首次使用可绑定白名单手机号</view><input class="input-line" placeholder="管理员手机号" value="{{phone}}" bindinput="inputPhone"/><view class="admin-tools"><view class="btn ghost" bindtap="bind">绑定权限</view><view class="btn secondary" bindtap="products">商品管理</view></view></view>
<view class="section-title">订单</view><view class="filter-bar"><view class="btn filter-chip {{filter === 'ALL' ? 'active' : ''}}" data-status="ALL" bindtap="setFilter">全部</view><view class="btn filter-chip {{filter === 'PAID' ? 'active' : ''}}" data-status="PAID" bindtap="setFilter">待制作</view><view class="btn filter-chip {{filter === 'MAKING' ? 'active' : ''}}" data-status="MAKING" bindtap="setFilter">制作中</view><view class="btn filter-chip {{filter === 'READY_FOR_DELIVERY' ? 'active' : ''}}" data-status="READY_FOR_DELIVERY" bindtap="setFilter">待配送</view><view class="btn filter-chip {{filter === 'COMPLETED' ? 'active' : ''}}" data-status="COMPLETED" bindtap="setFilter">已完成</view></view>
<view wx:if="{{loadError}}" class="card empty-state"><view class="empty-title">暂时无法获取订单</view><view class="muted">{{loadError}}</view></view>
<view wx:for="{{filteredOrders}}" wx:key="id" class="card merchant-order" data-id="{{item.id}}" bindtap="detail"><view class="row"><view class="order-number" style="margin:0">#{{item.order_no}}</view><view class="price">¥{{item.total_amount}}</view></view><view class="muted merchant-address">{{item.address}}</view><view class="row merchant-meta"><view class="status-badge">{{item.statusLabel}}</view><view class="muted">{{item.printLabel}}</view></view></view><view wx:if="{{loaded&&!filteredOrders.length&&!loadError}}" class="card empty-state"><view class="empty-title">暂无订单</view><view class="muted">当前筛选下没有需要处理的订单。</view></view></view>
