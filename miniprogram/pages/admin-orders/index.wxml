<view class="page"><view class="card"><view class="row"><view class="title">商家后台</view><view class="muted">{{lastUpdated}}</view></view><view class="muted">首次使用请绑定白名单手机号</view><input placeholder="管理员手机号" value="{{phone}}" bindinput="inputPhone" style="padding:18rpx 0"/><view class="btn secondary" bindtap="bind">绑定商家权限</view></view>
<view wx:for="{{orders}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="row"><view>#{{item.order_no}}</view><view class="price">¥{{item.total_amount}}</view></view><view class="muted">{{item.address}}</view><view>{{item.status}} · 打印 {{item.print_status}}</view></view><view wx:if="{{loaded&&!orders.length}}" class="muted">暂无已支付订单</view></view>
