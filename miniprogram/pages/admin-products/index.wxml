<view class="page">
  <view class="hero"><view class="title">商品管理</view><view class="muted hero-meta">维护菜单，顾客端会自动同步上架商品。</view></view>
  <view class="card form-card"><view class="section-title">添加商品</view>
    <text class="form-label">名称</text><input class="input-line" placeholder="例如：招牌大排粉" value="{{name}}" bindinput="inputName"/>
    <text class="form-label">售价</text><input class="input-line" placeholder="例如：15.00" type="digit" value="{{price}}" bindinput="inputPrice"/>
    <text class="form-label">分类</text><input class="input-line" placeholder="例如：粉面" value="{{category}}" bindinput="inputCategory"/>
    <view class="btn" bindtap="add">添加商品</view>
  </view>
  <view class="section-title">当前菜单</view><view wx:if="{{loadError}}" class="card empty-state"><view class="empty-title">暂时无法获取商品</view><view class="muted">{{loadError}}</view></view><view wx:for="{{products}}" wx:key="id" class="card product-card"><view wx:if="{{editingId === item.id}}"><text class="form-label">名称</text><input class="input-line" value="{{editName}}" bindinput="inputEditName"/><text class="form-label">售价</text><input class="input-line" value="{{editPrice}}" type="digit" bindinput="inputEditPrice"/><text class="form-label">分类</text><input class="input-line" value="{{editCategory}}" bindinput="inputEditCategory"/><view class="editing-actions"><view class="btn ghost" bindtap="cancelEdit">取消</view><view class="btn" bindtap="saveEdit">保存</view></view></view><view wx:else class="row"><view><view class="menu-name">{{item.name}}</view><view class="muted menu-price">{{item.category}} · ¥{{item.price}}</view></view><view class="product-actions"><view class="btn ghost" data-id="{{item.id}}" bindtap="startEdit">编辑</view><view class="btn {{item.enabled ? 'secondary' : ''}}" data-id="{{item.id}}" data-enabled="{{item.enabled}}" bindtap="toggle">{{item.enabled ? '下架' : '上架'}}</view></view></view></view>
</view>
