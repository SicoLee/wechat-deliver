<view class="page" wx:if="{{order}}"><view class="card"><view class="title">#{{order.order_no}}</view><view wx:for="{{order.items}}" wx:key="product_id" class="row"><view>{{item.product_name}} × {{item.quantity}}</view><view>¥{{item.unit_price}}</view></view><view class="row"><view>商品金额</view><view>¥{{order.goods_amount}}</view></view><view class="row"><view>配送费</view><view>¥{{order.delivery_fee}}</view></view><view class="row"><view>合计</view><view class="price">¥{{order.total_amount}}</view></view></view><view class="card"><view>配送状态：{{order.statusLabel}}</view><view style="margin-top:14rpx">送达地址：{{order.address}}</view><view style="margin-top:14rpx">配送距离：{{order.delivery_distance_km}} km</view><view wx:if="{{order.remark}}" style="margin-top:14rpx">备注：{{order.remark}}</view></view></view>
