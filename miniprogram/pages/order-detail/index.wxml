<view class="page"><view wx:if="{{loadError}}" class="card empty-state"><view class="empty-title">暂时无法获取订单</view><view class="muted">{{loadError}}</view><view class="btn secondary retry-button" bindtap="retry">重新加载</view></view><view wx:if="{{order}}"><view class="hero"><view class="order-number" style="margin:0">#{{order.order_no}}</view><view class="title" style="margin-top:10rpx">¥{{order.total_amount}}</view><view class="status-badge" style="margin-top:16rpx">{{order.statusLabel}}</view></view><view class="card order-progress-card"><view class="status-progress"><view class="status-step {{order.statusStep >= 1 ? 'is-active' : ''}}"></view><view class="status-step {{order.statusStep >= 2 ? 'is-active' : ''}}"></view><view class="status-step {{order.statusStep >= 3 ? 'is-active' : ''}}"></view><view class="status-step {{order.statusStep >= 4 ? 'is-active' : ''}}"></view></view><view class="status-labels muted"><text>已下单</text><text>制作中</text><text>待配送</text><text>已完成</text></view><view class="muted status-hint">{{order.statusHint}}</view></view><view class="card detail-summary"><view class="section-title" style="margin-top:0">本单菜品</view><view class="detail-list"><view wx:for="{{order.items}}" wx:key="product_id" class="row detail-row"><view>{{item.product_name}} × {{item.quantity}}</view><view>¥{{item.unit_price}}</view></view></view><view class="detail-divider"></view><view class="row detail-row"><view class="muted">商品金额</view><view>¥{{order.goods_amount}}</view></view><view class="row detail-row"><view class="muted">配送费</view><view>¥{{order.delivery_fee}}</view></view><view class="row detail-row"><view>合计</view><view class="price">¥{{order.total_amount}}</view></view></view><view class="card delivery-card"><view class="section-title" style="margin-top:0">配送信息</view><view>{{order.address}}</view><view class="muted" style="margin-top:12rpx">配送距离 {{order.delivery_distance_km}} km</view><view wx:if="{{order.remark}}" style="margin-top:18rpx">备注：{{order.remark}}</view></view></view></view>
