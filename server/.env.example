# 开发时不填则使用 server/data/dev.db。生产请指定 PostgreSQL URL。
DATABASE_URL=sqlite:///./data/dev.db
SHOP_NAME=妈妈的店
SHOP_LATITUDE=26.450000
SHOP_LONGITUDE=106.980000
DELIVERY_FEE=2.00
DELIVERY_PROVIDER=mock
# 切换真实骑行路线时设置：DELIVERY_PROVIDER=tencent_bicycling
# TENCENT_MAP_KEY=replace-with-your-server-side-key
EXTERNAL_REQUEST_TIMEOUT_SECONDS=5
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=wechat_v3
# WECHAT_PAY_MCHID=your-mchid
# WECHAT_PAY_APPID=your-miniprogram-appid
# WECHAT_PAY_API_V3_KEY=32-byte-api-v3-key
# WECHAT_PAY_PLATFORM_CERT_PATH=/secure/path/wechatpay-platform.pem
# JOB_TOKEN=long-random-token-used-only-by-server-side-scheduler
ADMIN_PHONES=18785409634,18285424586
# development：启用模拟支付/打印/距离；production：必须配置真实服务
APP_ENV=development
LOG_LEVEL=INFO
