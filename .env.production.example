# Copy to .env on the deployment server. Never commit the real .env file.
POSTGRES_DB=wechat_deliver
POSTGRES_USER=wechat_deliver
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://wechat_deliver:replace-with-a-long-random-password@postgres:5432/wechat_deliver
APP_ENV=development
LOG_LEVEL=INFO
